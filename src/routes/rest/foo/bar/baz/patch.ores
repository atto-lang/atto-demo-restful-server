import module telemetry from "../../../../../lib/telemetry";
import module store from "../../../../../lib/store";

define isoactor Handler as
  receive(ActorMail<String> mail): void {
    val request = http.claim(mail.value);
    val span = telemetry.actor_started(rt borrow request, "isolated");
    let int telemetry_status = 0;
    // Only this handler may clean a staging file it successfully created.
    // A pre-existing untrusted symlink must be preserved for inspection.
    let bool stage_owned = false;
    try {
      request.set_header("X-Route-File", "src/routes/rest/foo/bar/baz/patch.ores");
      if request.header("Content-Type") != "text/plain"; then
        await request.respond(415, "text/plain", "send Content-Type: text/plain");
        telemetry_status = 415;
        self.end();
        return;
      fi
      val String body = await request.body_text();
      if body == ""; then
        await request.respond(400, "text/plain", "body must not be empty");
        telemetry_status = 400;
        self.end();
        return;
      fi

      val Future<bool> pending_exists_1 = store.exists();

      val bool exists = await pending_exists_1;
      if !exists; then
        await request.respond(404, "text/plain", "resource not found");
        telemetry_status = 404;
        self.end();
        return;
      fi

      // Bound the existing representation before reading it into actor state.
      val Future<int> pending_size_2 = store.size();
      val int current_bytes = await pending_size_2;
      val int quota_limit_1 = store.max_resource_bytes();
      if current_bytes > quota_limit_1; then
        await request.respond(413, "text/plain", "existing resource exceeds persisted byte quota");
        telemetry_status = 413;
        self.end();
        return;
      fi

      val Future<String> pending_read_bounded_3 = store.read_bounded();

      val String current = await pending_read_bounded_3;
      val String updated = current + body;

      // UTF-8 byte quota, not character count. The staging file is safe here
      // because server admission is one exchange through actor finalization.
      val Future<void> pending_stage_for_size_4 = store.stage_for_size(updated);
      await pending_stage_for_size_4;
      stage_owned = true;
      val Future<int> pending_staged_size_5 = store.staged_size();
      val int updated_bytes = await pending_staged_size_5;
      val Future<void> pending_clear_stage_6 = store.clear_stage();
      await pending_clear_stage_6;
      stage_owned = false;
      val int quota_limit_2 = store.max_resource_bytes();
      if updated_bytes > quota_limit_2; then
        await request.respond(413, "text/plain", "resource exceeds persisted byte quota");
        telemetry_status = 413;
        self.end();
        return;
      fi

      val Future<void> pending_write_7 = store.write(updated);

      await pending_write_7;
      await request.respond(200, "text/plain; charset=utf-8", updated);
      telemetry_status = 200;
      self.end();
      return;
    } catch (failure) {
      span.event("ERROR", "handler failed");
      // A failed size/stat/unlink can leave quota staging after successful
      // installation. Best-effort async cleanup must not mask the original
      // failure or attempt to unlink an unowned pre-existing symlink.
      if stage_owned; then
        try {
          val Future<void> pending_clear_stage_8 = store.clear_stage();
          await pending_clear_stage_8;
          stage_owned = false;
        } catch (cleanup_failure) {
          span.event("ERROR", "quota staging cleanup failed");
        }
      fi
      if request.can_respond; then
        await request.respond(500, "text/plain", "Internal Server Error");
        telemetry_status = 500;
      fi
      self.end();
      return;
    } finally {
      span.finish(telemetry_status == 0 || telemetry_status >= 500 ? "error" : "ok", telemetry_status);
    }
  }
end

define module route as
  pub fnc handler(): HttpHandler { return http.handler("Handler"); }
end
